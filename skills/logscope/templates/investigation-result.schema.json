{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Investigation Result",
  "description": "LogScope 调查结果 Schema",
  "type": "object",
  "required": [
    "investigation_id",
    "status",
    "problem_summary",
    "scope",
    "primary_root_cause",
    "timeline",
    "hypotheses",
    "coverage_and_limitations",
    "evidence_index",
    "report_generated_at"
  ],
  "properties": {
    "investigation_id": {
      "type": "string",
      "description": "调查唯一标识",
      "pattern": "^INV-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "status": {
      "type": "string",
      "description": "调查状态",
      "enum": ["completed", "partial", "blocked", "failed"]
    },
    "problem_summary": {
      "type": "string",
      "description": "问题摘要（用户报告的症状）"
    },
    "scope": {
      "type": "object",
      "description": "调查范围",
      "required": ["environment", "time_range"],
      "properties": {
        "environment": {
          "type": "string",
          "description": "环境（prod, staging, dev 等）"
        },
        "time_range": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": {
              "type": "string",
              "format": "date-time"
            },
            "to": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "services": {
          "type": "array",
          "items": { "type": "string" },
          "description": "涉及的服务列表"
        },
        "correlation_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "相关的 correlation_id 列表"
        },
        "business_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "value"],
            "properties": {
              "field": { "type": "string" },
              "value": { "type": "string" }
            }
          },
          "description": "业务键列表"
        }
      }
    },
    "primary_root_cause": {
      "type": "object",
      "description": "主要根因",
      "required": ["category", "statement", "confidence", "evidence_ids"],
      "properties": {
        "category": {
          "type": "string",
          "description": "根因分类",
          "enum": [
            "data_error",
            "logic_error",
            "flow_error",
            "network_error",
            "resource_error",
            "config_permission_error",
            "unknown"
          ]
        },
        "statement": {
          "type": "string",
          "description": "根因陈述"
        },
        "confidence": {
          "type": "string",
          "description": "置信度",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "支持证据 ID 列表"
        }
      }
    },
    "timeline": {
      "type": "array",
      "description": "事件时间线",
      "items": {
        "type": "object",
        "required": ["timestamp", "service", "event", "log_id", "evidence_id", "event_kind"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "service": { "type": "string" },
          "event": { "type": "string" },
          "log_id": { "type": "string" },
          "evidence_id": { "type": "string" },
          "event_kind": {
            "type": "string",
            "enum": ["normal", "warning", "failure", "retry", "recovery", "unknown"]
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "description": "假设列表",
      "items": {
        "type": "object",
        "required": ["hypothesis_id", "category", "statement", "status", "confidence"],
        "properties": {
          "hypothesis_id": { "type": "string" },
          "category": { "type": "string" },
          "statement": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["proposed", "testing", "supported", "rejected", "inconclusive"]
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low", "unknown"]
          },
          "supporting_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "counter_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "missing_evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "database_checks": {
      "type": "array",
      "description": "数据库查询列表",
      "items": {
        "type": "object",
        "required": ["query_id", "datasource_id", "purpose", "status", "evidence_id"],
        "properties": {
          "query_id": { "type": "string" },
          "datasource_id": { "type": "string" },
          "purpose": { "type": "string" },
          "hypothesis_id": { "type": "string" },
          "query_type": {
            "type": "string",
            "enum": ["sql", "mongodb_aggregate"]
          },
          "query_intent": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["completed", "partial", "failed", "denied", "invalid", "timeout", "truncated", "no_rows"]
          },
          "row_count": { "type": "integer" },
          "truncated": { "type": "boolean" },
          "evidence_id": { "type": "string" },
          "interpretation": { "type": "string" }
        }
      }
    },
    "causal_chain": {
      "type": "array",
      "description": "因果链",
      "items": {
        "type": "object",
        "required": ["step", "description", "evidence_ids"],
        "properties": {
          "step": { "type": "integer" },
          "description": { "type": "string" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "counter_evidence": {
      "type": "array",
      "description": "反证列表",
      "items": {
        "type": "object",
        "required": ["evidence_id", "description"],
        "properties": {
          "evidence_id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "unresolved_questions": {
      "type": "array",
      "description": "未解决的问题",
      "items": { "type": "string" }
    },
    "coverage_and_limitations": {
      "type": "object",
      "description": "调查覆盖范围与限制",
      "required": ["log_search_status", "database_query_status", "partial_results"],
      "properties": {
        "log_search_status": {
          "type": "string",
          "enum": ["completed", "partial", "failed", "timeout"]
        },
        "database_query_status": {
          "type": "string",
          "enum": ["completed", "partial", "failed", "denied", "not_started", "timeout"]
        },
        "partial_results": { "type": "boolean" },
        "limitations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence_index": {
      "type": "array",
      "description": "证据索引",
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "source"],
        "properties": {
          "evidence_id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["log", "sql", "mongo", "metric", "config"]
          },
          "source": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "report_generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "报告生成时间"
    }
  }
}
